{
  "name": "store-api-tool-electron",
  "version": "1.0.0",
  "description": "Microsoft Store 文件直链查询工具（Electron 版）",
  "author": "Noah0115",
  "main": "main.js",
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .",
    "build": "vite build",
    "preview": "vite preview",
    "build:win": "npm run build && electron-builder --win portable"
  },
  "engines": {
    "node": ">=20 <24"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^37.1.0",
    "electron-builder": "^26.0.12",
    "vite": "^8.0.13",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.noah0115.storeapitool",
    "productName": "StoreApiTool",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "artifactName": "StoreApiTool.${ext}",
    "files": [
      "assets/**/*",
      "dist/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.12",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
